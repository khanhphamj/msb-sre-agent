# ============================================================================
# msb-sre-agent backend — copy to .env (local) / .env.<env> (deploy).
# Do NOT commit real .env files. Do NOT put GREENNODE_CLIENT_ID/SECRET/AGENT_IDENTITY/ENDPOINT_URL
# in the deploy env file — AgentBase Runtime injects them.
# ============================================================================
# local | dev | staging | prod — local only on your machine (AgentBase Runtime refuses APP_ENV=local)
APP_ENV=local
AGENT_NAME=msb-sre-agent
AGENT_VERSION=0.1.0
LOG_LEVEL=INFO

# --- IAM: do NOT set here. Local dev uses ONLY .greennode.json {"client_id","client_secret"};
# the runtime injects GREENNODE_CLIENT_ID/SECRET. Mixing sources (shell/.env/.greennode.json) => mismatched
# ID/secret pair => IAM 401 (the SDK falls back per field). Check: `env | grep GREENNODE_`.

# --- LLM: GreenNode AI Platform MaaS (OpenAI-compatible). Get key/model with /agentbase-llm ---
LLM_BASE_URL=https://maas-llm-aiplatform-hcm.api.vngcloud.vn/v1
LLM_API_KEY=
# the model's `path` field
LLM_MODEL=z-ai/glm-5.3-flash-thirdparty
# --- Tiers by capability (empty => use LLM_MODEL). Choose models: /agentbase-llm + skill agentbase-build-llm
# reasoning: multi-step reasoning/analysis/math/code · small: router, summaries, simple messages
LLM_MODEL_REASONING=
LLM_MODEL_LARGE=
LLM_MODEL_SMALL=
# Task -> tier (overrides defaults), e.g. {"agent":"large","summarize":"small","eval_judge":"reasoning"}
LLM_TASK_TIERS={}
# Router scores complexity each turn => agent uses small / large / reasoning
LLM_ADAPTIVE_ROUTING=false
# Fallback on infra/model errors (connection, timeout, 429, 5xx, model removed): per tier or a shared list
LLM_TIER_FALLBACKS={}
LLM_FALLBACK_MODELS=["qwen/qwen3.8-flash"]
LLM_TEMPERATURE=0.2
# Empty = no output token limit
LLM_MAX_TOKENS=
LLM_TIMEOUT_S=60
# With fallbacks, the primary model drops to 1 retry
LLM_MAX_RETRIES=2
# true => Langfuse gets TTFT
LLM_STREAMING=true
# false if the provider returns no usage when streaming
LLM_STREAM_USAGE=true

# --- Memory (create with /agentbase-memory) ---
# agentbase (dev/staging/prod) | inmemory (local)
MEMORY_BACKEND=inmemory
MEMORY_ID=
# Strategy id of the memory store (REQUIRED with LTM_ENABLED + MEMORY_BACKEND=agentbase; 'default' is refused)
MEMORY_STRATEGY_ID=default
# Long-term memory: OFF by default — enable only when the use case must remember users across sessions (decision-guide §1)
LTM_ENABLED=false
LTM_AUTO_RECALL=true
LTM_RECALL_LIMIT=5
# AgentBase Memory: timeout/retry per call (avoids hangs when the platform is flaky), search query ≤ 1000 chars
MEMORY_TIMEOUT_S=10
MEMORY_MAX_RETRIES=3
MEMORY_RETRY_BACKOFF_S=0.3
MEMORY_QUERY_MAX_CHARS=1000
# Platform: max 10 concurrent Memory requests / IAM account, SHARED across all replicas => ~10/replicas
MEMORY_MAX_CONCURRENCY=6
# Minimum score threshold for recall (empty = no filtering)
LTM_MIN_SCORE=

# --- Max agent <-> tools rounds per turn (exceeded => 422 "too many steps")
MAX_TOOL_ROUNDS=8

# --- Internal documents for the search_knowledge tool (.md/.txt; the tool is enabled only if the directory has files)
KNOWLEDGE_DIR=app/knowledge
KNOWLEDGE_TOP_K=3
KNOWLEDGE_SNIPPET_CHARS=600

# --- Mask PII (email, phone, CCCD) before sending Langfuse traces
TRACE_MASK_PII=true

# --- Whole-request time limit (exceeded => 504 / SSE error)
REQUEST_TIMEOUT_S=180

# --- Context compression ---
CONTEXT_MAX_TOKENS=12000
CONTEXT_KEEP_LAST=8
CONTEXT_HARD_LIMIT_TOKENS=24000

# --- MCP (servers declared in mcp_servers.json, supports ${VAR}) ---
MCP_CONFIG_FILE=mcp_servers.json
MCP_TOOL_TIMEOUT_S=30
# tools/list per server (servers load in parallel); failed server => skipped for MCP_FAILURE_TTL_S
MCP_LIST_TIMEOUT_S=8
MCP_FAILURE_TTL_S=60
# MCP Gateway endpoint (e.g. https://gw-<name>-<account>.agentbase-gateway.aiplatform.vngcloud.vn);
# each connector = ${MCP_GATEWAY_URL}/<connector-name>. List: GET /gateway/api/v1/mcp-connectors
MCP_GATEWAY_URL=https://gw-msb-samples-mcp-gateway-93356.agentbase-gateway.aiplatform.vngcloud.vn

# --- Inbound auth ---
# jwt (end-user via IdP) | api_key (trusted caller: server/BFF/test) | none (local only)
# The AgentBase Runtime endpoint has NO platform auth => outside local, jwt or api_key is mandatory.
AUTH_MODE=none
AUTH_TOKEN_HEADER=Authorization
# e.g. https://<issuer>/.well-known/jwks.json
AUTH_JWKS_URL=
AUTH_ISSUER=
AUTH_AUDIENCE=
AUTH_USER_CLAIM=sub
AUTH_ALGORITHMS=["RS256","ES256"]
# Outside local, jwt REQUIRES AUTH_ISSUER + AUTH_AUDIENCE; IdP doesn't issue aud (e.g. Cognito) => true
AUTH_ALLOW_NO_AUDIENCE=false
# App client ids allowed to call the agent (azp/client_id claim), JSON list — REQUIRED with AUTH_ALLOW_NO_AUDIENCE outside local
AUTH_ALLOWED_CLIENT_IDS=[]
# JWT claims passed to tools (config["configurable"]["user_claims"]), JSON list — e.g. ["employee_id","roles"]
AUTH_FORWARD_CLAIMS=[]
# api_key mode: header + JSON list of SHA-256 hex of the keys (generate: uv run python -c "import secrets,hashlib;k=secrets.token_urlsafe(32);print(k);print(hashlib.sha256(k.encode()).hexdigest())")
AUTH_API_KEY_HEADER=X-GreenNode-AgentBase-Custom-Api-Key
AUTH_API_KEY_SHA256=[]

# --- AgentBase Identity: page shown after OAuth2 3LO / delegated-key consent (must be in the identity's allowedReturnUrls)
IDENTITY_CALLBACK_URL=

# --- Human-in-the-loop: globs of tool names needing human approval (JSON list), e.g. ["gateway_*_delete","send_email"]
HITL_TOOLS=[]

# --- Self-evaluation loop (optional, costs extra LLM calls) ---
REFLECTION_ENABLED=false
REFLECTION_MAX_RETRIES=1
# Skip reflection for messages adaptive routing rates "simple"
REFLECTION_SKIP_SIMPLE=true
# Criteria the judge grades answers on — write them for your domain
REFLECTION_CRITERIA=On point, accurate to the tool data, nothing made up, complete, in the user's language.

# --- A2A (Agent2Agent): enable so other agents can call via /.well-known/agent-card.json + POST /a2a
A2A_ENABLED=false
# Public URL (Agent Card). Empty => GREENNODE_ENDPOINT_URL injected by the runtime
A2A_PUBLIC_URL=
A2A_DESCRIPTION=AgentBase agent
# Skills published on the Agent Card (JSON list {id,name,description,tags,examples})
A2A_SKILLS=[{"id":"chat","name":"Chat","description":"Answers questions in natural language"}]
A2A_TIMEOUT_S=120
# Other agents this agent calls (client) — see a2a_agents.json
A2A_AGENTS_FILE=a2a_agents.json

# --- Feedback token (HMAC user+trace). Empty => derived from GREENNODE_CLIENT_SECRET (runtime-injected)
FEEDBACK_SIGNING_KEY=

# --- CORS (only when the frontend runs on web), JSON list ---
CORS_ALLOW_ORIGINS=[]

# --- Langfuse (empty keys => tracing off) ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# or a self-hosted Langfuse
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_SAMPLE_RATE=1.0
# (optional) use Langfuse Prompt Management
LANGFUSE_PROMPT_NAME=
LANGFUSE_PROMPT_LABEL=production

# --- Zalo Bot channel (app/channels/zalo.py). The bot token and the webhook secret are NOT here: they are Static API
# Key providers in Access Control (names below). Enable only on the Runtime, after the providers exist.
ZALO_ENABLED=false
ZALO_API_BASE=https://bot-api.zaloplatforms.com
ZALO_TOKEN_PROVIDER=msb-sre-zalo-bot-token
ZALO_SECRET_PROVIDER=msb-sre-zalo-webhook-secret
ZALO_SECRET_TTL_S=300
# Zalo user ids allowed to chat (JSON list). Empty = nobody: each sender is told their own id so an admin can add it.
ZALO_ALLOWED_USER_IDS=[]
# Chats answered at the same time / messages that may wait behind the one being answered (MaaS: 10 requests/min per account)
ZALO_MAX_WORKERS=3
ZALO_MAX_QUEUE_PER_CHAT=3
# Send a "still working" message when there is no answer after this many seconds (0 = never)
ZALO_NOTICE_AFTER_S=10
# Chat sessions rotate at local midnight in this timezone
ZALO_TIMEZONE=Asia/Ho_Chi_Minh
